# OpenAI API key used directly by Paid Scheduler AI (server-side only).
OPENAI_API_KEY=

# Paid Scheduler AI uses GPT-6.1 Sol through the OpenAI Responses API.
SCHEDULER_AI_PAID_MODEL=gpt-6.1-sol

# Optional vision model used only to read uploaded scheduler screenshots.
SCHEDULER_AI_VISION_MODEL=gpt-5.4

# Kill switch for AI schedule writes. When false, the assistant stays read-only.
SCHEDULER_AI_AUTONOMOUS_WRITES=true
