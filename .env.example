# MongoDB Atlas connection string used by the schedule maker.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/sos_scheduler

# Automatic Scheduler AI only. Production Vercel deployments can use AI Gateway OIDC.
# For local development, set an AI Gateway key if you are not using Vercel OIDC.
AI_GATEWAY_API_KEY=

# Optional Paid AI model override. Free/Native AI never reads this setting.
SCHEDULER_AI_PAID_MODEL=openai/gpt-5.6-sol

# Optional vision model used only to read uploaded scheduler screenshots.
SCHEDULER_AI_VISION_MODEL=openai/gpt-5.4

# Kill switch for AI schedule writes. When false, the assistant stays read-only.
SCHEDULER_AI_AUTONOMOUS_WRITES=true
