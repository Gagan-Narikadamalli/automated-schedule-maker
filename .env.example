# MongoDB Atlas connection string used by the schedule maker.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/sos_scheduler

# Optional OpenAI provider; used only with SCHEDULER_AI_PROVIDER=openai.
# Server only: never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_SCHEDULER_MODEL=gpt-6.1-sol
# Optional vision model; defaults to the same model.
OPENAI_SCHEDULER_VISION_MODEL=gpt-6.1-sol

# Kill switch for AI schedule writes. When false, the assistant stays read-only.
SCHEDULER_AI_AUTONOMOUS_WRITES=true

# Active cloud provider for both AI Generate and the assistant.
SCHEDULER_AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_SCHEDULER_MODEL=gemini-3.6-flash
# Optional stronger full-day planner when chat uses a lighter Gemini model.
GEMINI_SCHEDULER_PLANNING_MODEL=
# Optional; otherwise uses GEMINI_SCHEDULER_MODEL.
GEMINI_SCHEDULER_VISION_MODEL=
