# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/sos_scheduler

# Long random secret used to sign login sessions and protect OTP hashes.
# Generate a unique value for the real deployment. Do not commit the real secret.
AUTH_SECRET=replace-with-a-long-random-secret

# One-time secret used only to create the first administrator account.
# After the first account exists, the setup endpoint refuses additional setup.
SETUP_KEY=replace-with-a-private-setup-key

# Gmail account used to send one-time login codes for normal clinic accounts.
GMAIL_USER=your-sos-scheduler-email@gmail.com

# Google App Password for the Gmail account above.
# Do not use the normal Gmail password.
GMAIL_APP_PASSWORD=replace-with-google-app-password

# Optional temporary testing account.
# When both variables exist, that exact account can sign in directly without OTP.
# Remove both variables before final production launch to require normal account + OTP login.
TEMP_LOGIN_USERNAME=replace-with-test-username
TEMP_LOGIN_PASSWORD=replace-with-test-password
